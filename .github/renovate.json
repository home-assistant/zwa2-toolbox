{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "enabledManagers": ["github-actions", "npm"],
  "minimumReleaseAge": "3 days",
  "schedule": ["before 8am on monday"],
  "semanticCommits": "disabled",
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "description": "Refresh the lock file weekly, so indirect dependencies come in one PR instead of one PR each",
    "enabled": true,
    "schedule": ["before 8am on monday"]
  },
  "packageRules": [
    {
      "description": "Label npm updates",
      "matchManagers": ["npm"],
      "addLabels": ["javascript"]
    },
    {
      "description": "All other non-major npm updates in one weekly PR",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm dependencies (non-major)",
      "groupSlug": "npm-non-major"
    },
    {
      "description": "Z-Wave JS packages share a release",
      "matchPackageNames": ["zwave-js", "@zwave-js/**"],
      "groupName": "Z-Wave JS",
      "groupSlug": "zwave-js"
    },
    {
      "description": "React and its types",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "React",
      "groupSlug": "react"
    },
    {
      "description": "ESLint and its plugins",
      "matchPackageNames": [
        "eslint",
        "@eslint/**",
        "typescript-eslint",
        "eslint-plugin-*"
      ],
      "groupName": "ESLint",
      "groupSlug": "eslint"
    },
    {
      "description": "Tailwind CSS",
      "matchPackageNames": ["tailwindcss", "@tailwindcss/**"],
      "groupName": "Tailwind CSS",
      "groupSlug": "tailwind"
    },
    {
      "description": "Vite and its React plugin",
      "matchPackageNames": ["vite", "@vitejs/**"],
      "groupName": "Vite",
      "groupSlug": "vite"
    },
    {
      "description": "Leave runner labels and action version inputs alone",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["github-runner", "uses-with"],
      "enabled": false
    },
    {
      "description": "Our own actions that follow a branch (like home-assistant/actions@master) float on purpose. Pinning them would open a digest PR in every repository for each change to them. Our own actions on a version tag are pinned like any other.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["home-assistant/**"],
      "matchCurrentValue": "/^(dev|main|master)$/",
      "pinDigests": false
    }
  ]
}
